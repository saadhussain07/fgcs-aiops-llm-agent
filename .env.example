# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# Groq API key — required. Obtain from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LLM model identifier (as reported in the paper, Section 5.4)
LLM_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Telemetry backend endpoints.
# Defaults assume `kubectl port-forward` bridges cluster ClusterIPs to
# localhost, as described in Section 5.3 of the paper.
# ---------------------------------------------------------------------------

PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686

# ---------------------------------------------------------------------------
# Pipeline parameters (defaults match the reported configuration)
# ---------------------------------------------------------------------------

# Monitoring interval in seconds (Section 5.3)
MONITORING_INTERVAL=30

# Confidence gate threshold (Section 4.6)
CONFIDENCE_THRESHOLD=0.85

# Self-consistency vote count (Section 4.5)
VOTE_COUNT=5

# LLM sampling temperature and token ceiling (Section 5.4)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=3000
